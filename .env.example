# ---------------------------------------------------------------------------
# Cross Cart Global — environment template
# Copy to .env.local (development) or configure these in your host dashboard.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# Core (required)
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/crosscart
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string
PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email / SMTP (verification + notifications)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Courier tracking
TRACKING_PROVIDER=trackingmore
TRACKINGMORE_API_KEY=
TRACKINGMORE_BASE_URL=https://api.trackingmore.com/v4
TRACKINGMORE_DAILY_LIMIT=100
TRACKINGMORE_WEBHOOK_SECRET=
TRACKING_API_KEY=
TRACKING_API_URL=
SYNC_ALL_MAX_PER_RUN=40
CRON_SECRET=replace-with-a-long-random-string

# Shared rate limiting (recommended for serverless / multiple instances)
# Without these, rate limits are per-process only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# CORS allowlist for browser clients on other origins (comma-separated).
# Leave empty for same-origin only (recommended). API clients with Bearer
# tokens do not need CORS.
CORS_ALLOWED_ORIGINS=

# SMS (optional)
SMS_PROVIDER=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# Analytics / marketing pixels (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_SEND_TO=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_PINTEREST_TAG_ID=
NEXT_PUBLIC_TWITTER_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# AWB prefix for generated air waybills
AWB_PREFIX=132
